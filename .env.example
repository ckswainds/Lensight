# ─────────────────────────────────────────────────────────────────
# Lensight Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# --- LLM Configuration (Required) ---
PRIMARY_LLM_PROVIDER=gemini

# Primary LLM (Gemini)
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM (HuggingFace)
HF_FALLBACK_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_FALLBACK_MAX_TOKENS=1500
HF_FALLBACK_TEMPERATURE=0.3

# --- RAG Configuration (Required) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_TYPE=chroma
RETRIEVAL_TOP_K=5
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# --- LangSmith Observability (Optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=Lensight
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Dashboard Configuration (Optional) ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
DASHBOARD_DEBUG=false
